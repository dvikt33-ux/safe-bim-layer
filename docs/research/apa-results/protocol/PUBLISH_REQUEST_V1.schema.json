{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APA Research OS publish inbox request V1",
  "description": "Submit as inbox/APA-RUN-YYYYMMDD-HHMMSSZ-slug.json. GitHub push workflow publishes immutable run and receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "plan_id",
    "action_id",
    "substep_id",
    "executor",
    "executor_run_id",
    "phase",
    "started_at",
    "finished_at",
    "scope",
    "source_revisions",
    "inputs",
    "claims",
    "evidence",
    "report_markdown",
    "next_substep",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "APA_PUBLISH_REQUEST_V1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^APA-RUN-20[0-9]{6}-[0-9]{6}Z-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^APA-P[0-9]{2}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^APA-P[0-9]{2}\\.A[0-9]{2}$"
    },
    "substep_id": {
      "type": "string",
      "pattern": "^APA-P[0-9]{2}\\.A[0-9]{2}\\.S[0-9]{2}$"
    },
    "executor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executor_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "phase": {
      "enum": [
        "SOURCE",
        "OFFLINE",
        "SYNTHETIC",
        "BUILD",
        "LIVE"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "repository"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "dvikt33-ux/safe-bim-layer"
        },
        "archicad": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdk": {
          "type": [
            "string",
            "null"
          ]
        },
        "tapir": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "revision",
          "source_sha"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{40,64}$"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "status",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^APA-CLAIM-[A-Z0-9-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SOURCE_VERIFIED",
              "REPORTED",
              "NOT_VERIFIED",
              "TEST_REQUIRED",
              "OFFLINE_PASS",
              "BUILD_PASS",
              "LIVE_PASS",
              "CONFLICT"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "uri",
          "kind",
          "verification",
          "sha256",
          "source_revision"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "OFFICIAL_DOC",
              "SOURCE_CODE",
              "GITHUB_PR",
              "GITHUB_COMMIT",
              "LOCAL_LOG",
              "TEST_RESULT",
              "USER_SUPPLIED",
              "OTHER"
            ]
          },
          "verification": {
            "enum": [
              "READBACK_VERIFIED",
              "SOURCE_READ",
              "REPORTED",
              "NOT_VERIFIED"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "report_markdown": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500000
    },
    "next_substep": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APA-P[0-9]{2}\\.A[0-9]{2}\\.S[0-9]{2}$"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_modified",
        "pln_modified",
        "apx_modified",
        "tested_branches_modified",
        "paid_runtime_used"
      ],
      "properties": {
        "main_modified": {
          "const": false
        },
        "pln_modified": {
          "const": false
        },
        "apx_modified": {
          "const": false
        },
        "tested_branches_modified": {
          "const": false
        },
        "paid_runtime_used": {
          "const": false
        }
      }
    }
  }
}
