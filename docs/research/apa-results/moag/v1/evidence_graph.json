  "questions": [
    {
      "id": "Q01",
      "priority": "BLOCKER",
      "text": "Найти эпизод карты Первого уровня после взлома лона; сопоставить состояние до/после."
    },
    {
      "id": "Q02",
      "priority": "BLOCKER",
      "text": "Перепроверить энергомодуль, осевое расположение, диапазон высот и отношение к Главной площади."
    },
    {
      "id": "Q03",
      "priority": "BLOCKER",
      "text": "Установить реальные габариты трех уровней по тексту и иллюстрациям; без псевдоразмеров."
    },
    {
      "id": "Q04",
      "priority": "BLOCKER",
      "text": "Восстановить все маршруты Нижнего уровня: Овальная, Темная, Дикая базы, ангары, склад, мусорка, заблокированный проход."
    },
    {
      "id": "Q05",
      "priority": "HIGH",
      "text": "Проработать все книги III и IV с разграничением МОАГа и других станций."
    },
    {
      "id": "Q06",
      "priority": "HIGH",
      "text": "Проверить количество/планировки баз 3 и 4 и их исторические названия."
    },
    {
      "id": "Q07",
      "priority": "HIGH",
      "text": "Разметить мебель, отделку, освещение, энергоснабжение как зависимые слои, без преждевременной записи в BIM."
    },
    {
      "id": "Q08",
      "priority": "HIGH",
      "text": "Подтвердить взаимную ориентацию капитанской рубки, детского блока, отдыха, шлюзов и производства."
    }
  ]
