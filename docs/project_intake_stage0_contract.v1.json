    "ARCHICAD_READBACK",
    "APPROVED_PROJECT_DECISION",
    "RULE_REGISTRY",
    "USER_CORRECTION"
  ],
  "applicabilityStatuses": [
    "APPLICABLE",
    "NOT_APPLICABLE",
    "CONDITIONAL",
    "UNKNOWN"
