    "REGULATORY_APPLICABILITY_BLOCKER",
    "SITE_GEOMETRY_BLOCKER",
    "STRUCTURAL_ENGINEERING_BLOCKER",
    "FUNCTIONAL_PLANNING_BLOCKER",
    "DOCUMENTATION_BLOCKER",
    "OPTIONAL_PREFERENCE"
  ],
  "progressionGate": {
    "requiredStageStatus": "VERIFIED",
    "conditions": {
      "projectClassification": "VERIFIED",
      "applicabilityMatrixComplete": true,
      "requiredInputMatrixComplete": true,
      "missingRequiredCount": 0,
      "unresolvedConflictCount": 0,
      "blockingUnknownDerivableCount": 0,
      "unapprovedAssumptionCount": 0,
      "provenanceCompleteForBlockingInputs": true
    },
    "blockingInputStatuses": [
      "MISSING_REQUIRED",
      "CONFLICT",
      "UNKNOWN_BUT_DERIVABLE"
    ],
    "forbidSilentFallbacks": [
      "PLACEHOLDER",
      "GUESSED_VALUE",
      "TYPICAL_VALUE",
      "UNAPPROVED_DEFAULT",
      "STATISTICALLY_LIKELY_VALUE"
    ]
  },
  "questionPolicy": {
    "inspectAllAvailableContextFirst": true,
    "askKnownDataAgain": false,
    "askMinimumUnblockingSet": true,
    "reauditAfterAnswers": true,
    "questionMustExplain": [
      "WHAT_IS_NEEDED",
      "WHY_IT_IS_NEEDED",
      "DEPENDENT_RULE_OR_STAGE",
      "ACCEPTED_FORMAT_OR_UNITS"
    ]
  },
  "derivationPolicy": {
    "deriveBeforeAskingWhenDeterministic": true,
    "requiresConfirmedInputs": true,
    "requiresTraceableMethod": true,
    "requiresUnits": true,
    "requiresProvenance": true,
    "forbidSubjectiveInferenceAsDerived": true
  },
  "invalidationPolicy": {
    "reopenOnMaterialClassificationChange": true,
    "reopenOnApplicableRuleChange": true,
    "reopenOnBlockingInputChange": true,
    "scopeInvalidationToDependenciesWhenSafe": true
  },
