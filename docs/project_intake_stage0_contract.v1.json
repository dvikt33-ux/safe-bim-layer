    "DERIVED",
    "UNKNOWN_BUT_DERIVABLE",
    "CONFLICT",
    "MISSING_REQUIRED",
    "MISSING_OPTIONAL",
    "NOT_APPLICABLE"
  ],
  "requiredSequence": [
    "COLLECT_AVAILABLE_PROJECT_INFORMATION",
    "NORMALIZE_AND_INDEX_SOURCES",
    "CLASSIFY_PROJECT",
    "BUILD_APPLICABILITY_MATRIX",
    "BUILD_REQUIRED_INPUT_MATRIX",
    "MAP_EXISTING_DATA_TO_REQUIREMENTS",
    "DERIVE_SAFE_DERIVABLE_VALUES",
    "DETECT_CONFLICTS",
    "IDENTIFY_GAPS",
    "PRIORITIZE_USER_QUESTIONS",
    "REAUDIT_AFTER_USER_ANSWERS"
  ],
  "sourceClasses": [
