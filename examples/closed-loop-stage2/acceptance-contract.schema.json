{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 2 acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["goalId", "criteria"],
  "properties": {
    "goalId": {"type": "string", "pattern": "\\S"},
    "criteria": {
      "type": "array", "minItems": 1,
      "contains": {"type": "object", "required": ["required"], "properties": {"required": {"const": true}}},
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "required", "check", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "required": {"type": "boolean"},
          "check": {"type": "string", "pattern": "\\S"},
          "expected": {},
          "tolerance": {"type": "number", "minimum": 0, "default": 0},
          "correctable": {"type": "boolean", "default": false}
        }
      }
    }
  },
  "$comment": "Runtime also rejects duplicate criterion IDs, non-finite values and non-JSON payloads. Actual, verdict and evidenceRefs are computed in audit results, never supplied as acceptance verdicts."
}
